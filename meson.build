project('media-downloader-gtk', 'c', version: '1.0.0', meson_version: '>=0.61', default_options: ['c_std=c11', 'warning_level=3', 'werror=true'])
add_project_arguments('-D_POSIX_C_SOURCE=200809L', '-DGDK_VERSION_MIN_REQUIRED=GDK_VERSION_4_6', '-DGDK_VERSION_MAX_ALLOWED=GDK_VERSION_4_6', language: 'c')
gtk = dependency('gtk4', version: '>=4.6', include_type: 'system')
gio = dependency('gio-2.0', version: '>=2.70')
json = dependency('json-glib-1.0', version: '>=1.6')
core_sources = files('src/utils.c', 'src/video-info.c', 'src/format-selector.c', 'src/downloader.c', 'src/download-manager.c', 'src/preferences.c')
core = static_library('media-core', core_sources, dependencies: [gio, json])
gnome = import('gnome')
resources = gnome.compile_resources('media-resources', 'data/resources.xml', source_dir: 'data', c_name: 'media_resources')
executable('media-downloader-gtk', resources, 'src/main.c', 'src/window.c', link_with: core, dependencies: [gtk, gio, json], install: true)
test_bin = executable('test-core', 'tests/test-core.c', include_directories: include_directories('src'), link_with: core, dependencies: [gio, json])
test('core', test_bin, timeout: 60)
install_data('data/media-downloader-gtk.desktop', install_dir: get_option('datadir') / 'applications')
install_data('data/icons/media-downloader-gtk.svg', install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps')
install_data('LICENSE', 'THIRD_PARTY.md', install_dir: get_option('datadir') / 'doc/media-downloader-gtk')
integration_bin = executable('test-integration', 'tests/integration.c', include_directories: include_directories('src'), link_with: core, dependencies: [gio, json])
executable('test-ui', resources, 'tests/test-ui.c', 'src/window.c', include_directories: include_directories('src'), link_with: core, dependencies: [gtk, gio, json])
